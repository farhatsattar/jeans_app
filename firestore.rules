rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if user owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Products: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories: Public read, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Customers: Own data only (read/write), Admin can do all
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId) || isAdmin();
      allow update: if isOwner(customerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders: Own orders only, Admin can do all
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isAdmin()
        || (request.auth != null && request.resource.data.customerId == request.auth.uid)
        || request.resource.data.customerId.matches('guest-.*');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews: Public read + anyone can create (guest reviews allowed)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'productId',
          'productName',
          'customerId',
          'customerName',
          'rating',
          'comment',
          'createdAt'
        ])
        && request.resource.data.productId is string
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 1
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 1
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Settings: Public read (for site config), Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users collection: Users can read their own profile, Admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
