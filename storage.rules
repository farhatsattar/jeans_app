rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /product-images/{productId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && isImage() && isUnder5MB();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isImage() && isUnder5MB();
    }

    // Guest review photos (no login required)
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if isImage() && isUnder5MB();
    }

    match /user-uploads/{userId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && isImage() && isUnder5MB();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
